.{
    .ua = "clash-verge/v2.2.3",
    .subscriptions = .{
        .{ .name = "trojan-base64", .url = "fixtures/base64_trojan.txt" },
        .{ .name = "clash-yaml", .url = "fixtures/clash.yaml" },
        .{ .name = "vmess-json", .url = "fixtures/vmess_json.txt" },
        .{ .name = "vless-reality", .url = "fixtures/vless_reality.txt" },
        .{ .name = "plain-mixed", .url = "fixtures/plain_uris.txt" },
        .{ .name = "ss-sip002", .url = "fixtures/ss_sip002.txt" },
        .{ .name = "ssr", .url = "fixtures/ssr.txt" },
        .{ .name = "v2rayn-json", .url = "fixtures/v2rayn.json" },
        .{ .name = "singbox-json", .url = "fixtures/singbox.json" },
        // anonymous subscription (no name): full pipeline, no "name@" prefix
        .{ .url = "fixtures/plain_uris.txt" },
        // BOM-prefixed subscription: exercises the BOM stripping path
        .{ .name = "bom", .url = "fixtures/bom_uris.txt" },
        // intentionally broken subscription (content is HTML): exercises the parse-error path;
        // every run shows one W line, which is expected
        .{ .name = "broken-source", .url = "fixtures/html_error.html" },
    },
    // inline node URIs / node files (same semantics as --node / --node-file)
    .nodes = .{ "trojan://pass@cli1.example.com:443#inline-node" },
    .node_files = .{ "fixtures/plain_uris.txt" },
}
